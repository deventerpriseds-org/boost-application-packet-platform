node_modules/
# No trailing slash as well: the pattern above matches a DIRECTORY only, and the render harnesses
# (scripts/render-app.mjs, render-spec.mjs, compare-ui.mjs) need playwright-core resolvable from the
# repo root, which is easiest as a SYMLINK to a scratch install. A symlink is not a directory, so
# `node_modules/` did not match it and the Stop hook flagged it as untracked work.
node_modules
dist/
.env
.env.local
*.local
.DS_Store
api/dist/
web/dist/
*.js.map
local.settings.json

# Subagent worktrees — transient, never part of the repo
.claude/worktrees/

# scratch deps pulled in for scripts/intent-probe.mjs (playwright-core, @babel/standalone)
/package.json
/package-lock.json
/node_modules/

# verify.sh RUN RECEIPTS, not evidence. Each pass writes three sidecars next to its artifact:
#   .ac-<slug>.json / .verify-<slug>-<loop>.json   the raw claude -p result envelope
#   .<same>.out                                    the child's progress line (the liveness signal --
#                                                  a pass is alive iff this file is growing)
#   .<same>.err                                    the child's stderr
# The DELIVERABLE is the AC-<slug>.md / VERIFY-<slug>-<loop>.md beside them, and that IS committed.
# Committing the receipts adds per-run noise to every branch and was already ruled out once in
# eds-claude-skills (dcb9ecc, "Do not commit run receipts for a pass that targeted another repo").
docs/qc-evidence/.ac-*.json
docs/qc-evidence/.ac-*.out
docs/qc-evidence/.ac-*.err
docs/qc-evidence/.verify-*.json
docs/qc-evidence/.verify-*.out
docs/qc-evidence/.verify-*.err
